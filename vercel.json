{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.fineglaze.com"
        }
      ],
      "destination": "https://fineglaze.com/:path*",
      "permanent": true
    },
    {
      "source": "/fine-glaze-company-profile.pdf",
      "destination": "/docs/fine-glaze-company-profile.pdf",
      "permanent": false
    },
    {
      "source": "/louvers",
      "destination": "/aluminium-louvers",
      "permanent": true
    },
    {
      "source": "/services/acp-cladding",
      "destination": "/acp-aluminium-cladding",
      "permanent": true
    },
    {
      "source": "/services/curtain-wall",
      "destination": "/curtain-wall-systems",
      "permanent": true
    },
    {
      "source": "/services/structural-glazing",
      "destination": "/structural-glazing",
      "permanent": true
    },
    {
      "source": "/aluminium-facade",
      "destination": "/aluminium-windows-doors",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/"
    }
  ]
}
