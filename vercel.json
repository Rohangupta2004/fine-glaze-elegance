{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.fineglaze.com"
        }
      ],
      "destination": "https://fineglaze.com/:path*",
      "permanent": true
    },
    {
      "source": "/fine-glaze-company-profile.pdf",
      "destination": "/docs/fine-glaze-company-profile.pdf",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/"
    }
  ]
}
